          },
          "server_time": {
            "type": "string",
            "format": "date-time"
          },
          "title": {
            "type": "string"
          },
          "total_stock": {
            "type": "integer",
            "format": "int32"
          },
          "window_status": {
            "$ref": "#/components/schemas/WindowStatus"
          }
        }
      },
      "FlashItemListResponse": {
        "type": "object",
        "required": [
          "items",
          "server_time"
        ],
        "properties": {
          "items": {
            "type": "array",
